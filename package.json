{
  "name": "sugarch-utilities",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint . --ext .ts,.tsx",
    "ci-lint": "pnpm type-check && pnpm lint && pnpm build",
    "push-release": "git checkout release -q && git merge main -q && git push && git checkout main -q"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "changeset": "^0.2.6",
    "eslint": "^10.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "dependencies": {
    "@changesets/cli": "^2.29.6"
  }
}
