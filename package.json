{
  "name": "sugarch-utilities",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint . --ext .ts,.tsx",
    "ci-lint": "pnpm type-check && pnpm lint && pnpm build",
    "push-release": "git checkout release -q && git merge main -q && git push && git checkout main -q"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "changeset": "^0.2.6",
    "eslint": "^10.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "dependencies": {
    "@changesets/cli": "^2.29.6"
  }
}
