{
  "name": "sugarch-utilities",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint . --ext .ts,.tsx",
    "ci-lint": "pnpm type-check && pnpm lint && pnpm build",
    "push-release": "git checkout release -q && git merge main -q && git push && git checkout main -q"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "changeset": "^0.2.6",
    "eslint": "^10.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "dependencies": {
    "@changesets/cli": "^2.29.6"
  }
}
